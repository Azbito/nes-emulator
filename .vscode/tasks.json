{
  "tasks": [
    {
      "type": "cppbuild",
      "label": "C/C++: g++.exe build active file",
      "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
      "args": [
        "-fdiagnostics-color=always",
        "-g",
        "${workspaceFolder}/main.cpp",
        "${workspaceFolder}/src/CPU/CPU6502.cpp",
        "${workspaceFolder}/src/JIT/Compiler.cpp",
        "-I",
        "${workspaceFolder}/src/CPU",
        "${workspaceFolder}/src/JIT",
        "${workspaceFolder}/src/Memory",
        "-o",
        "${workspaceFolder}/main.exe"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": ["$gcc"],
      "group": "build",
      "detail": "Task generated by Debugger."
    }
  ],
  "version": "2.0.0"
}
